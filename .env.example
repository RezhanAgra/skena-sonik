# Variabel untuk docker-compose di VPS. Salin jadi .env di root repo lalu isi.

# Domain yang sudah diarahkan (A record) ke IP VPS, tanpa https://
DOMAIN=skenasonik.com
# Email untuk notifikasi sertifikat HTTPS Let's Encrypt
ACME_EMAIL=kamu@email.com

# Supabase → Connect → ORMs → Prisma
# Transaction pooler (port 6543), dipakai API
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct (port 5432), dipakai migrasi
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------- Pembayaran (Midtrans Snap) ----------
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# ganti true setelah akun Midtrans produksi aktif
MIDTRANS_IS_PRODUCTION=false

# ---------- E-tiket & gerbang ----------
# openssl rand -hex 32
TICKET_SECRET=
# PIN petugas gerbang untuk https://DOMAIN/gate
GATE_TOKEN=

# ---------- Email e-tiket (Gmail SMTP + App Password) ----------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---------- Akun ----------
# Email penyelenggara (jadi ORGANIZER setelah daftar + verifikasi email), pisahkan dengan koma
ORGANIZER_EMAILS=
