---
import CartButton from './CartButton.tsx';

const socials = [
  {
    label: 'Instagram', href: 'https://www.instagram.com',
    path: 'M12 7a5 5 0 100 10 5 5 0 000-10zm0 8a3 3 0 110-6 3 3 0 010 6zm5.2-8.4a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0zM12 2.2c-2.7 0-3 0-4 .1-3.6.2-5.5 2.1-5.7 5.7-.1 1-.1 1.4-.1 4s0 3 .1 4c.2 3.6 2.1 5.5 5.7 5.7 1 .1 1.4.1 4 .1s3 0 4-.1c3.6-.2 5.5-2.1 5.7-5.7.1-1 .1-1.4.1-4s0-3-.1-4c-.2-3.6-2.1-5.5-5.7-5.7-1-.1-1.3-.1-4-.1zm0 1.8c2.6 0 2.9 0 3.9.1 2.6.1 3.9 1.4 4 4 .1 1 .1 1.3.1 3.9s0 2.9-.1 3.9c-.1 2.6-1.4 3.9-4 4-1 .1-1.3.1-3.9.1s-2.9 0-3.9-.1c-2.6-.1-3.9-1.4-4-4-.1-1-.1-1.3-.1-3.9s0-2.9.1-3.9c.1-2.6 1.4-3.9 4-4 1-.1 1.3-.1 3.9-.1z'
  },
  { label: 'X', href: 'https://x.com', path: 'M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.3l4.4 5.9L17.8 3zm-1.1 16.2h1.7L7.2 4.7H5.4l11.3 14.5z' },
  { label: 'YouTube', href: 'https://www.youtube.com', path: 'M23 7.2a3 3 0 00-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 001 7.2 31 31 0 00.5 12a31 31 0 00.5 4.8 3 3 0 002.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 002.1-2.1 31 31 0 00.5-4.8 31 31 0 00-.5-4.8zM9.7 15V9l5.8 3-5.8 3z' },
  { label: 'TikTok', href: 'https://www.tiktok.com', path: 'M16.6 2h-3.4v13.4a2.9 2.9 0 11-2.9-2.9c.3 0 .6 0 .8.1V9.1a6.3 6.3 0 105.5 6.3V8.6a7.9 7.9 0 004.6 1.5V6.7a4.6 4.6 0 01-4.6-4.7z' }
];

const menu = [
  { label: 'Home', href: '#top' },
  { label: 'Tur', href: '#tur' },
  { label: 'Lineup', href: '#lineup' },
  { label: 'Jadwal', href: '#jadwal' },
  { label: 'Tiket', href: '#tiket' }
];
---

<header class="sticky top-[env(safe-area-inset-top,0px)] z-30 py-2.5">
  <div class="wrap">
    <div
      class="grid grid-cols-[auto_1fr_auto] items-center gap-2.5 rounded-[18px] border border-line bg-black/80 px-3 py-2.5 shadow-[0_0_40px_rgb(255_31_31/0.12)] backdrop-blur-md sm:grid-cols-[1fr_auto_1fr] sm:px-4.5"
    >
      <div class="flex gap-0.5 sm:gap-3" aria-label="Media sosial">
        {socials.map((s, i) => (
          <a
            href={s.href}
            aria-label={s.label}
            class:list={['grid size-7.5 place-items-center rounded-lg text-flare hover:bg-flare/10', i > 1 && 'max-sm:hidden']}
          >
            <svg viewBox="0 0 24 24" class="size-[17px] fill-current"><path d={s.path} /></svg>
          </a>
        ))}
      </div>

      <a href="#top" class="grid justify-items-center gap-1.5 no-underline">
        <span class="logo-type text-[clamp(1.7rem,3.4vw,2.4rem)]">Skena Sonik</span>
        <small class="font-mono text-[0.58rem] tracking-[0.3em] text-muted">TOUR 2026</small>
      </a>

      <CartButton client:load />

      <nav class="col-span-full" aria-label="Utama">
        <ul class="m-0 flex list-none flex-wrap justify-center gap-3.5 p-0 text-xs font-bold sm:gap-5 sm:text-sm">
          {menu.map((m, i) => (
            <li><a href={m.href} class:list={['no-underline hover:text-paper', i === 0 ? 'text-paper' : 'text-flare']}>{m.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
