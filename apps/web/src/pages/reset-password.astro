---
import AuthShell from '../components/auth/AuthShell.astro';
import { ResetForm } from '../components/auth/AuthForms.tsx';

const token = Astro.url.searchParams.get('token') ?? '';
// token rahasia di URL: jangan sampai tersimpan di cache atau terkirim sebagai referrer
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---

<AuthShell title="Buat password baru">
  <ResetForm client:load token={token} />
</AuthShell>
