// Skema database Skena Sonik Tour 2026
// Jalankan `npm run db:migrate` setelah mengubah file ini.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CityStatus {
  SOLD_OUT
  LOW
  ON_SALE
  SOON
}

/// Kota yang disinggahi tur
model City {
  id        Int        @id @default(autoincrement())
  code      String     @unique @db.VarChar(3)
  name      String
  dateLabel String
  status    CityStatus
  sortOrder Int        @default(0)
}

/// Panggung di grand finale Jakarta
model Stage {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  sortOrder    Int           @default(0)
  performances Performance[]
}

/// Genre lineup, sekaligus persona hasil vibe check
model Genre {
  slug         String   @id
  label        String
  bio          String
  personaName  String
  personaStage String
  personaDesc  String
  sortOrder    Int      @default(0)
  artists      Artist[]
}

model Artist {
  slug        String       @id
  name        String
  headliner   Boolean      @default(false)
  genreSlug   String
  genre       Genre        @relation(fields: [genreSlug], references: [slug])
  performance Performance?
  songs       Song[]
}

/// Jadwal tampil: satu artis tampil sekali. Jam disimpan sebagai menit sejak 00:00.
model Performance {
  id          Int    @id @default(autoincrement())
  artistSlug  String @unique
  artist      Artist @relation(fields: [artistSlug], references: [slug], onDelete: Cascade)
  stageId     Int
  stage       Stage  @relation(fields: [stageId], references: [id])
  day         Int // 1 = Sabtu 12 Des, 2 = Minggu 13 Des
  startMinute Int
  endMinute   Int

  @@index([day, stageId])
}

/// Lagu yang tampil di slider "Dengerin dulu sebelum nonton"
model Song {
  id         Int    @id @default(autoincrement())
  title      String
  artistSlug String
  artist     Artist @relation(fields: [artistSlug], references: [slug], onDelete: Cascade)
  speed      Float  @default(1) // tempo animasi layar LED
  sortOrder  Int    @default(0)
}

model TicketTier {
  slug       String      @id
  name       String
  price      Int // rupiah per orang
  perks      String[]
  badge      String?
  soldOut    Boolean     @default(false)
  squadPrice Int? // harga per orang kalau beli >= squadMin
  squadMin   Int?
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING // menunggu pembayaran
  PAID // lunas
  FAILED // ditolak / gagal
  EXPIRED // tidak dibayar sampai batas waktu
  CANCELLED // dibatalkan
  REFUNDED // dana dikembalikan
}

/// Pesanan tiket. `code` dipakai sebagai order_id di payment gateway dan di URL /pesanan/[code].
model Order {
  id              Int         @id @default(autoincrement())
  code            String      @unique
  status          OrderStatus @default(PENDING)
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  subtotal        Int
  fee             Int
  total           Int
  paymentProvider String // midtrans | mock
  paymentToken    String?
  paymentUrl      String?
  paymentType     String? // qris, gopay, bank_transfer, credit_card, dll.
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status])
}

/// Baris tiket di dalam pesanan. Harga disalin saat checkout supaya tidak berubah kalau harga tier diubah.
model OrderItem {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tierSlug  String
  tier      TicketTier @relation(fields: [tierSlug], references: [slug])
  tierName  String
  quantity  Int
  unitPrice Int
  subtotal  Int

  @@index([orderId])
}
