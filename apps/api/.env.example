# Koneksi PostgreSQL yang dipakai API saat jalan.
# Supabase: pakai "Transaction pooler" (port 6543) dan tambahkan ?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Koneksi untuk migrasi Prisma (npm run db:migrate / db:seed / db:studio).
# Supabase: pakai "Session pooler" atau direct connection (port 5432). Untuk PostgreSQL lokal boleh dikosongkan.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Port API Express
PORT=4000

# Opsional. Web memanggil API lewat /api di domain yang sama, jadi CORS tidak diperlukan.
# Isi hanya kalau API di-host di domain berbeda dari web (pisahkan dengan koma).
# CORS_ORIGIN="https://skenasonik.com"
# Jumlah reverse proxy di depan API (Caddy/Nginx = 1) supaya rate limit membaca IP asli pengunjung.
# TRUST_PROXY=1

# ---------- Pembayaran ----------
# mock = pembayaran simulasi (development/demo); midtrans = Midtrans Snap
PAYMENT_PROVIDER=mock
# Midtrans → Settings → Access Keys (sandbox: dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = sandbox (uang bohongan), true = produksi (uang sungguhan)
MIDTRANS_IS_PRODUCTION=false
# URL web, tujuan kembali setelah bayar (/pesanan/KODE)
SITE_URL=http://localhost:4321
